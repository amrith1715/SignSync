# Upload only inputs needed for the static frontend builder.
# The Python backend remains in Git and in the local project.
/*
!/.vercelignore
!/vercel.json
!/package.json
!/package-lock.json
!/index.html
!/scripts
!/scripts/build-vercel.mjs
!/scripts/build-browser.mjs
!/browser
!/browser/**
!/assets
!/assets/**
/assets/vendor/**
/assets/browser-worker.js
!/dynamic_sign_videos
!/dynamic_sign_videos/**
/dynamic_sign_videos/source/
/dynamic_sign_videos/source/**
!/label_mapping.json
!/model.json
!/group1-shard1of1.bin
!/tfjs_model
!/tfjs_model/**
